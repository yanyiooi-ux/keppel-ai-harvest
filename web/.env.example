# Copy this file to web/.env.local (Next.js reads its settings from the web folder).
# web/.env.local is gitignored and must never be committed or pasted into any chat.

# Tencent Cloud TokenHub, OpenAI-compatible endpoint. Copy the base URL from the TokenHub console.
LLM_BASE_URL=
# Your TokenHub API key.
LLM_API_KEY=
# A Hunyuan model id from the TokenHub console.
LLM_MODEL=

# Only sets where the AI switch in the top bar starts: 1 = Replay (saved real AI answers from web/data/replay/,
# no network, no key needed), anything else = Live. Once someone picks Live, Replay or Off on the switch, its
# cookie wins. An empty LLM_API_KEY turns Replay on by itself. npm run ai:ping and npm run ai:record ignore it.
REPLAY_MODE=1
